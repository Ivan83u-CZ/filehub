# Runtime secrets and private material
.env
.env.*
!.env.example
pki/*
!pki/.gitkeep

# Runtime state and local backups
state/*
!state/.gitkeep
backups/
telemetry-read/
artifacts/

# Logs and transient files
*.log
*.bak
*.before-*
*.tmp
*.swp
*.db
*.sqlite
*.sqlite3
*.dump
__pycache__/
*.py[cod]

# Local archives; the current widget package is kept in dist/
*.tar
*.tar.gz
*.tgz
*.zip
!dist/*.zip
!dist/*.sha256

