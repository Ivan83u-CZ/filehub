# Add to the PHP service environment (no secrets in this file).
# off | shadow | enforce. Keep shadow until the manifest contains every active lead.
FILEHUB_LEAD_ACL_MODE=shadow
FILEHUB_LEAD_ACL_FILE=/var/www/ops10/acl/lead-acl.json
# Shadow denials are sampled to avoid one ACL row per thumbnail. 0 disables,
# 100 logs every would-be denial. Enforcement denials are always logged.
FILEHUB_LEAD_ACL_LOG_SAMPLE_PCT=10
